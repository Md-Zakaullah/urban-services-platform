generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("customer")
  createdAt DateTime  @default(now())
  bookings  Booking[]
  sessions  Session[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id          String    @id
  name        String
  category    String
  description String
  price       Int
  rating      Float     @default(0)
  reviews     Int       @default(0)
  icon        String
  duration    String
  active      Boolean   @default(true)
  bookings    Booking[]
}

model Booking {
  id          Int      @id @default(autoincrement())
  userId      Int
  serviceId   String
  contactName String
  contactPhone String
  location    String
  date        String
  time        String
  notes       String?
  status      String   @default("requested")
  amount      Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}
